    "id": "equation-16",
    "section": "Compare options at one junction",
    "latex": "V^{\\pi}(s)=\\sum_a\\pi(a|s)Q^{\\pi}(s,a)."
  },
  {
    "id": "equation-17",
    "section": "9. Advantage Functions",
    "latex": "A^{\\pi}(s,a)=Q^{\\pi}(s,a)-V^{\\pi}(s)."
  },
  {
    "id": "equation-18",
    "section": "Worked example: better than your usual choice",
    "latex": "A^{\\pi}(s,\\text{east})=8-5.5=2.5,\\qquad\nA^{\\pi}(s,\\text{north})=3-5.5=-2.5."
  },
  {
    "id": "equation-19",
    "section": "10. Bellman Expectation Equations",
    "latex": "V^{\\pi}(s)=\\mathbb{E}_{\\pi}\\left[R_{t+1}+\\gamma V^{\\pi}(S_{t+1})\\mid S_t=s\\right]."
  },
  {
    "id": "equation-20",
    "section": "10. Bellman Expectation Equations",
    "latex": "V^{\\pi}(s)=\\sum_a\\pi(a|s)\\sum_{s',r}p(s',r|s,a)\\left[r+\\gamma V^{\\pi}(s')\\right]."
  },
  {
    "id": "equation-21",
    "section": "One-step lookahead, with numbers",
    "latex": "-1+0.9[0.75(8)+0.25(4)]=5.3."
  },
  {
    "id": "equation-22",
    "section": "One-step lookahead, with numbers",
    "latex": "Q^{\\pi}(s,a)=\\sum_{s',r}p(s',r|s,a)\n\\left[r+\\gamma\\sum_{a'}\\pi(a'|s')Q^{\\pi}(s',a')\\right]."
  },
  {
    "id": "equation-23",
    "section": "11. Bellman Optimality Equations",
    "latex": "V^{*}(s)=\\max_a \\mathbb{E}\\left[R_{t+1}+\\gamma V^{*}(S_{t+1})|S_t=s,A_t=a\\right]."
  },
  {
    "id": "equation-24",
    "section": "11. Bellman Optimality Equations",
    "latex": "Q^{*}(s,a)=\\mathbb{E}\\left[R_{t+1}+\\gamma\\max_{a'}Q^{*}(S_{t+1},a')\\right]."
  },
  {
    "id": "equation-25",
    "section": "11. Bellman Optimality Equations",
    "latex": "a^{*}=\\arg\\max_a Q^{*}(s,a)."
  },
  {
    "id": "equation-26",
    "section": "13. Policy Evaluation",
    "latex": "V_{k+1}(s)\\leftarrow\\sum_a\\pi(a|s)\\sum_{s',r}p(s',r|s,a)[r+\\gamma V_k(s')]."
  },
  {
    "id": "equation-27",
    "section": "14. Policy Improvement",
    "latex": "\\pi'(s)=\\arg\\max_a\\sum_{s',r}p(s',r|s,a)[r+\\gamma V^{\\pi}(s')]."
  },
  {
    "id": "equation-28",
    "section": "16. Value Iteration",
    "latex": "V_{k+1}(s)=\\max_a\\sum_{s',r}p(s',r|s,a)[r+\\gamma V_k(s')]."
  },
  {
    "id": "equation-29",
    "section": "17. Monte Carlo Methods",
    "latex": "V(S_t)\\leftarrow V(S_t)+\\alpha[G_t-V(S_t)]."
  },
  {
    "id": "equation-30",
    "section": "18. Temporal-Difference Learning",
    "latex": "V(S_t)\\leftarrow V(S_t)+\\alpha\\underbrace{[R_{t+1}+\\gamma V(S_{t+1})-V(S_t)]}_{\\text{TD error}}."
  },
  {
    "id": "equation-31",
    "section": "18. Temporal-Difference Learning",
    "latex": "R_{t+1}+\\gamma V(S_{t+1})"
  },
  {
    "id": "equation-32",
    "section": "19. SARSA",
    "latex": "S_t,A_t,R_{t+1},S_{t+1},A_{t+1}."
  },
  {
    "id": "equation-33",
    "section": "19. SARSA",
    "latex": "Q(S_t,A_t)\\leftarrow Q(S_t,A_t)+\\alpha[R_{t+1}+\\gamma Q(S_{t+1},A_{t+1})-Q(S_t,A_t)]."
  },
  {
    "id": "equation-34",
    "section": "20. Q-Learning and Exploration",
    "latex": "R_{t+1}+\\gamma\\max_{a'}Q(S_{t+1},a')."
  },
  {
    "id": "equation-35",
    "section": "20. Q-Learning and Exploration",
    "latex": "Q(S_t,A_t)\\leftarrow Q(S_t,A_t)+\\alpha\\left[R_{t+1}+\\gamma\\max_{a'}Q(S_{t+1},a')-Q(S_t,A_t)\\right]."
  },
  {
    "id": "equation-36",
    "section": "20. Q-Learning and Exploration",
    "latex": "A_t=\\begin{cases}\n\\text{random action} & \\text{with probability }\\epsilon\\\\\n\\arg\\max_aQ(S_t,a) & \\text{otherwise.}\n\\end{cases}"
  },
  {
    "id": "equation-37",
    "section": "21. Function Approximation",
    "latex": "\\hat V(s;w),\\qquad \\hat Q(s,a;w),\\qquad \\pi_\\theta(a|s)."
