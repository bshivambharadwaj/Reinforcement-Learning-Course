  {
    "id": "equation-03",
    "section": "3. Markov Decision Processes",
    "latex": "\\mathcal{M}=(\\mathcal{S},\\mathcal{A},P,R,\\gamma)."
  },
  {
    "id": "equation-04",
    "section": "3. Markov Decision Processes",
    "latex": "P(S_{t+1}|S_t,A_t,S_{t-1},\\ldots)=P(S_{t+1}|S_t,A_t)."
  },
