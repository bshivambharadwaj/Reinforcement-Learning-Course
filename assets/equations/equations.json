  {
    "id": "equation-10",
    "section": "6. Returns and Discounting",
    "latex": "G_t=R_{t+1}+\\gamma R_{t+2}+\\gamma^{2}R_{t+3}+\\cdots."
  },
  {
    "id": "equation-11",
    "section": "6. Returns and Discounting",
