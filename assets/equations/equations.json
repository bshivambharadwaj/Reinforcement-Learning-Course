  {
    "id": "equation-13",
    "section": "7. State-Value Functions",
    "latex": "V^{\\pi}(s)=\\mathbb{E}_{\\pi}[G_t|S_t=s]."
  },
  {
    "id": "equation-14",
    "section": "8. Action-Value Functions",
    "latex": "Q^{\\pi}(s,a)=\\mathbb{E}_{\\pi}[G_t|S_t=s,A_t=a]."
  },
  {
    "id": "equation-15",
    "section": "8. Action-Value Functions",
    "latex": "\\pi(s)=\\arg\\max_a Q(s,a)"
