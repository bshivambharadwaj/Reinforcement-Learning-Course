  {
    "id": "equation-61",
    "section": "31. Proximal Policy Optimization",
    "latex": "L^{CLIP}(\\theta)=\\mathbb{E}\\left[\n\\min\\left(r_t(\\theta)\\hat A_t,\n\\mathrm{clip}(r_t(\\theta),1-\\epsilon,1+\\epsilon)\\hat A_t\\right)\n\\right]."
  },
