[
  {
    "id": "equation-01",
    "section": "1. What Is Reinforcement Learning?",
    "latex": "J(\\pi)=\\mathbb{E}_{\\pi}\\left[\\sum_{t=0}^{\\infty}\\gamma^{t} R_{t+1}\\right]."
  },
  {
    "id": "equation-02",
    "section": "2. The Agent–Environment Interaction",
    "latex": "\\tau=(S_0,A_0,R_1,S_1,A_1,R_2,\\ldots)."
