    "id": "equation-47",
    "section": "25. Policy Gradient Methods",
    "latex": "\\nabla_\\theta J(\\theta)\\propto\n\\mathbb{E}\\left[\\nabla_\\theta\\log\\pi_\\theta(A_t|S_t)Q^{\\pi}(S_t,A_t)\\right]."
